# ============================================================
#  Variables de entorno — CUOC ISA
#  cp .env.example .env
#  NUNCA subas .env al repositorio
# ============================================================

# ── Base de datos ────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-password
DB_DATABASE=clasificacion
DB_PORT_HOST=5433
DB_SYNCHRONIZE=false
DB_SSL=false

# ── Puertos en el host ───────────────────────────────────────
BACKEND_PORT=3000
# FRONTEND_PORT es por máquina: 4200 en desarrollo, 80 en el servidor.
# docker-compose.prod.yml publica '${FRONTEND_PORT:-80}:80', así que un .env
# copiado desde un equipo de desarrollo dejaría el sitio en el 4200.
FRONTEND_PORT=4200

# ── Redis (caché) ─────────────────────────────────────────────
# Producción: openssl rand -hex 32. CACHE_ENABLED=false apaga la caché sin
# tocar código (todo va directo a PostgreSQL).
REDIS_PASSWORD=cambia-esta-password-redis
REDIS_PORT_HOST=6379
REDIS_MAXMEMORY=256mb
CACHE_TTL_SECONDS=600
CACHE_ENABLED=true

# ── JWT (producción: openssl rand -base64 48) ────────────────
JWT_SECRET=change-me-genera-con-openssl-rand-base64-48
JWT_EXPIRES_IN=1d
BCRYPT_SALT=12

# ── Sesión (cookie httpOnly) ─────────────────────────────────
# true en cuanto el sitio se sirva por HTTPS (la cookie deja de viajar por
# HTTP plano). Con true sobre HTTP el navegador no guarda la cookie y nadie
# puede iniciar sesión. deploy-prod.sh --https lo pone en true solo.
COOKIE_SECURE=false
# Orígenes del frontend que pueden llamar a la API con la sesión, separados
# por coma. Vacío = los de desarrollo (localhost/127.0.0.1 en 4200 y 4201).
# Detrás de Nginx el frontend y la API comparten origen y no hace falta.
CORS_ORIGINS=

# ── HTTPS (deploy-prod.sh --https) ───────────────────────────
# Carpeta con fullchain.pem y privkey.pem. Nunca se sube a git.
TLS_CERT_DIR=./certs
FRONTEND_HTTPS_PORT=443

# ── API keys de sistemas externos ────────────────────────────
# Única forma de consultar los datos desde otro sistema: cabecera x-api-key.
# Una llave por consumidor (se revoca una sin afectar a las demás).
# Generar cada una con: openssl rand -hex 32   (mínimo 32 caracteres)
# Buscador de ocupaciones: solo /api/public/consulta
API_KEY_BUSCADOR=
# Sistema APE: consultas CNO/CUOC/correlativa (ve el campo ocupacional)
API_KEY_APE=
# Sistema Tendencias: mismas consultas, sin campo ocupacional
API_KEY_TENDENCIAS=
# Peticiones por minuto por llave; quien lo supera espera 5 minutos.
API_KEY_LIMITE_POR_MINUTO=300
